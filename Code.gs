/**
 * 과학 교구 어디 있지? — 구글 시트 연동 스크립트 (Google Apps Script)
 *
 * 사용법은 README.md를 보세요. 요약:
 *  1) 구글 시트에서 [확장 프로그램 › Apps Script]를 열고 이 코드를 통째로 붙여 넣은 뒤 저장
 *  2) 시트를 새로 고침 → 메뉴 [교구 앱 › 처음 설정하기] → [교구 앱 › 수정 비밀번호 정하기]
 *  3) Apps Script에서 [배포 › 새 배포 › 웹 앱] (실행: 나 / 액세스 권한: 모든 사용자)
 *  4) 나온 웹 앱 주소를 index.html 의 GAS_URL 에 붙여 넣기
 */

const SHEETS = {
  '수납함': ['수납함', '실', '분류', '위층 칸 수', '아래층 칸 수', '가로 위치', '세로 위치', '너비', '높이', '이름표 위치', 'ID'],
  '교구':   ['교구명', '수량·규격', '수납함', '층', '열', '칸', '다른 이름', '폐시약 처리 연도', 'ID'],
};
const NUMERIC = ['가로 위치', '세로 위치', '너비', '높이', '칸'];   // 칸 수는 "3,3"처럼 쓰므로 글자로 둡니다
const TZ = 'Asia/Seoul';
const MAX_ROWS = 5000;

/* ---------------- 시트 메뉴 ---------------- */
function onOpen() {
  SpreadsheetApp.getUi().createMenu('교구 앱')
    .addItem('처음 설정하기 (기본 데이터 채우기)', 'setup')
    .addItem('수정 비밀번호 정하기', 'setPassword')
    .addSeparator()
    .addItem('웹 앱 배포 방법 보기', 'showHelp')
    .addToUi();
}

/** 시트에서 직접 고치면 '기준 날짜'를 오늘로 바꿉니다. */
function onEdit(e) {
  try {
    const name = e && e.range && e.range.getSheet().getName();
    if (name && SHEETS[name]) touch_();
  } catch (err) { /* 무시 */ }
}

function setup() {
  const ui = SpreadsheetApp.getUi();
  const ss = SpreadsheetApp.getActive();
  const hasData = Object.keys(SHEETS).some(n => { const s = ss.getSheetByName(n); return s && s.getLastRow() > 1; });
  if (hasData) {
    const r = ui.alert('처음 설정하기', '‘교구’ 또는 ‘수납함’ 시트에 이미 내용이 있어요.\n기본 데이터로 덮어쓰면 지금 내용은 사라집니다. 계속할까요?', ui.ButtonSet.YES_NO);
    if (r !== ui.Button.YES) return;
  }
  const order = ['교구', '수납함'];
  order.forEach((name, i) => {
    let sh = ss.getSheetByName(name);
    if (!sh) sh = ss.insertSheet(name, i);
    sh.clear();
    sh.getDataRange().clearDataValidations();
    sh.clearConditionalFormatRules();
    const headers = SHEETS[name];
    sh.getRange(1, 1, 1, headers.length).setValues([headers])
      .setFontWeight('bold').setBackground('#1F3864').setFontColor('#FFFFFF').setHorizontalAlignment('center');
    sh.setFrozenRows(1);
    writeRows_(sh, SEED[name] || []);
  });
  // 기본 빈 시트 정리
  ss.getSheets().forEach(s => { if (!SHEETS[s.getName()] && s.getLastRow() === 0 && ss.getSheets().length > 2) ss.deleteSheet(s); });
  decorate_();
  touch_();
  ui.alert('처음 설정하기', '기본 데이터를 채웠어요.\n다음으로 [교구 앱 › 수정 비밀번호 정하기]를 실행하세요.', ui.ButtonSet.OK);
}

/** 보기 좋게: 열 너비, 입력 목록(드롭다운), 폐시약 행 색칠 */
function decorate_() {
  const ss = SpreadsheetApp.getActive();
  const it = ss.getSheetByName('교구'), cb = ss.getSheetByName('수납함');
  const col = (sh, h) => sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].indexOf(h) + 1;
  const list = (vals) => SpreadsheetApp.newDataValidation().requireValueInList(vals, true).setAllowInvalid(true).build();
  if (it) {
    [['교구명', 220], ['수량·규격', 200], ['수납함', 110], ['층', 70], ['열', 70], ['칸', 50], ['다른 이름', 200], ['폐시약 처리 연도', 120], ['ID', 60]]
      .forEach(([h, w]) => { const c = col(it, h); if (c) it.setColumnWidth(c, w); });
    const cCab = col(it, '수납함'), cFloor = col(it, '층'), cCol = col(it, '열'), cWaste = col(it, '폐시약 처리 연도'), cId = col(it, 'ID');
    if (cb && cCab) it.getRange(2, cCab, MAX_ROWS, 1).setDataValidation(
      SpreadsheetApp.newDataValidation().requireValueInRange(cb.getRange(2, 1, MAX_ROWS, 1), true).setAllowInvalid(true).build());
    if (cFloor) it.getRange(2, cFloor, MAX_ROWS, 1).setDataValidation(list(['위층', '아래층', '-']));
    if (cCol) { it.getRange(2, cCol, MAX_ROWS, 1).setDataValidation(list(['-', '왼쪽', '오른쪽'])); it.getRange(1, cCol).setNote('칸이 두 줄(왼쪽·오른쪽)인 수납함만 적어요. 한 줄이면 - 로 둡니다.'); }
    if (cId) { it.getRange(1, cId).setNote('비워 두면 앱이 자동으로 붙입니다. 이미 있는 값은 바꾸지 마세요.'); it.getRange(2, cId, MAX_ROWS, 1).setFontColor('#999999'); }
    if (cWaste) {
      const letter = it.getRange(1, cWaste).getA1Notation().replace(/\d+/g, '');
      it.setConditionalFormatRules([SpreadsheetApp.newConditionalFormatRule()
        .whenFormulaSatisfied('=$' + letter + '2<>""').setBackground('#FFEDD5').setFontColor('#9A3412')
        .setRanges([it.getRange(2, 1, MAX_ROWS, it.getLastColumn())]).build()]);
      it.getRange(1, cWaste).setNote('폐시약으로 처리할 연도(예: 2027)를 적으면 앱에 ‘폐시약’으로 표시됩니다.');
    }
    it.getRange(1, 1).setNote('한 줄에 교구 하나. ‘수납함’은 수납함 시트의 이름과 똑같이, ‘칸’은 각 층(두 줄이면 각 줄)의 위에서부터 1, 2, 3…');
  }
  if (cb) {
    [['수납함', 110], ['실', 90], ['분류', 100]].forEach(([h, w]) => { const c = col(cb, h); if (c) cb.setColumnWidth(c, w); });
    const cRoom = col(cb, '실'), cGroup = col(cb, '분류'), cLabel = col(cb, '이름표 위치'), cId = col(cb, 'ID');
    if (cRoom) cb.getRange(2, cRoom, 200, 1).setDataValidation(list(['준비실', '프로젝트실', '과학실']));
    if (cGroup) cb.getRange(2, cGroup, 200, 1).setDataValidation(list(['지구과학', '운동과에너지', '물질', '생명과학', '공통', '안전', '시약', '기타']));
    const cUp = col(cb, '위층 칸 수'), cLow = col(cb, '아래층 칸 수');
    [cUp, cLow].forEach(c => { if (c) cb.getRange(2, c, 200, 1).setNumberFormat('@'); });   // "3,3"이 숫자 33으로 바뀌지 않게
    if (cUp) cb.getRange(1, cUp).setNote('위에서부터 센 칸 수. 칸이 왼쪽·오른쪽 두 줄이면 쉼표로: 3,3 (왼쪽 3칸, 오른쪽 3칸). 층 구분이 없으면 ‘아래층 칸 수’는 비워 둡니다.');
    if (cLabel) cb.getRange(2, cLabel, 200, 1).setDataValidation(list(['아래', '위', '오른쪽', '안쪽']));
    if (cId) cb.getRange(2, cId, 200, 1).setFontColor('#999999');
    cb.getRange(1, 1).setNote('수납함 이름을 바꾸면 ‘교구’ 시트의 수납함 이름도 함께 바꿔야 합니다. (앱에서 바꾸면 자동으로 함께 바뀝니다.)');
  }
}

function setPassword() {
  const ui = SpreadsheetApp.getUi();
  const r = ui.prompt('수정 비밀번호 정하기', '앱에서 교구 정보를 수정할 때 쓸 비밀번호를 입력하세요. (6자 이상 권장)\n학생들에게는 알려 주지 마세요.', ui.ButtonSet.OK_CANCEL);
  if (r.getSelectedButton() !== ui.Button.OK) return;
  const pw = r.getResponseText().trim();
  if (pw.length < 4) { ui.alert('비밀번호는 4자 이상으로 정해 주세요.'); return; }
  PropertiesService.getScriptProperties().setProperty('EDIT_PASSWORD', pw);
  ui.alert('수정 비밀번호를 저장했어요.');
}

function showHelp() {
  SpreadsheetApp.getUi().alert('웹 앱 배포 방법',
    '1. [확장 프로그램 › Apps Script]를 엽니다.\n' +
    '2. 오른쪽 위 [배포 › 새 배포]를 누릅니다.\n' +
    '3. 유형 선택(톱니바퀴)에서 [웹 앱]을 고릅니다.\n' +
    '4. 다음 사용자 인증 정보로 실행: 나 / 액세스 권한이 있는 사용자: 모든 사용자\n' +
    '5. [배포]를 누르고 나오는 ‘웹 앱 URL’(…/exec)을 복사합니다.\n' +
    '6. index.html 의 GAS_URL = "" 따옴표 안에 붙여 넣고 깃허브에 올립니다.\n\n' +
    '※ 코드를 고친 뒤에는 [배포 › 배포 관리 › 연필 › 버전: 새 버전]으로 다시 배포해야 주소가 그대로 유지됩니다.',
    SpreadsheetApp.getUi().ButtonSet.OK);
}

/* ---------------- 웹 앱 ---------------- */
function doGet(e) {
  return respond_(() => {
    const action = (e && e.parameter && e.parameter.action) || 'get';
    if (action === 'ping') return { ok: true };
    return readAll_();
  });
}

function doPost(e) {
  return respond_(() => {
    let body;
    try { body = JSON.parse((e && e.postData && e.postData.contents) || '{}'); }
    catch (err) { throw { code: 'bad_request', message: '요청 형식이 올바르지 않아요.' }; }
    if (body.action === 'check') { auth_(body.password); return { ok: true }; }
    if (body.action === 'save') {
      auth_(body.password);
      const data = body.data || {};
      Object.keys(SHEETS).forEach(n => {
        if (!Array.isArray(data[n])) throw { code: 'bad_request', message: n + ' 데이터가 없어요.' };
        if (data[n].length > MAX_ROWS) throw { code: 'too_large', message: '줄 수가 너무 많아요.' };
      });
      const lock = LockService.getScriptLock();
      if (!lock.tryLock(20000)) throw { code: 'busy', message: '다른 저장이 진행 중이에요.' };
      try {
        const now = readAll_();
        if (body.baseVersion && body.baseVersion !== now.version) throw { code: 'conflict', message: '그사이 내용이 바뀌었어요.' };
        const ss = SpreadsheetApp.getActive();
        Object.keys(SHEETS).forEach(n => writeRows_(ss.getSheetByName(n), data[n]));
        SpreadsheetApp.flush();
        touch_();
        const after = readAll_();
        return { ok: true, version: after.version, updated: after.updated };
      } finally { lock.releaseLock(); }
    }
    throw { code: 'bad_request', message: '알 수 없는 요청이에요.' };
  });
}

/* ---------------- 내부 함수 ---------------- */
function respond_(fn) {
  let out;
  try { out = fn(); }
  catch (err) { out = { ok: false, code: (err && err.code) || 'error', message: (err && err.message) || String(err) }; }
  return ContentService.createTextOutput(JSON.stringify(out)).setMimeType(ContentService.MimeType.JSON);
}

function auth_(pw) {
  const saved = PropertiesService.getScriptProperties().getProperty('EDIT_PASSWORD');
  if (!saved) throw { code: 'no_password', message: '수정 비밀번호가 아직 없어요.' };
  if (typeof pw !== 'string' || pw !== saved) { Utilities.sleep(800); throw { code: 'unauthorized', message: '비밀번호가 맞지 않아요.' }; }
}

function readAll_() {
  const ss = SpreadsheetApp.getActive();
  const out = { ok: true };
  const raw = [];
  Object.keys(SHEETS).forEach(n => {
    const sh = ss.getSheetByName(n);
    if (!sh) throw { code: 'no_sheet', message: '‘' + n + '’ 시트가 없어요.' };
    const values = sh.getDataRange().getValues();
    raw.push(values);
    const headers = (values[0] || []).map(h => String(h).trim());
    out[n] = values.slice(1)
      .filter(r => r.some(v => v !== '' && v !== null))
      .map(r => { const o = {}; headers.forEach((h, i) => { if (h) o[h] = r[i] instanceof Date ? Utilities.formatDate(r[i], TZ, 'yyyy-MM-dd') : r[i]; }); return o; });
  });
  const digest = Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, JSON.stringify(raw), Utilities.Charset.UTF_8);
  out.version = Utilities.base64Encode(digest);
  out.updated = PropertiesService.getScriptProperties().getProperty('UPDATED') || Utilities.formatDate(new Date(), TZ, 'yyyy-MM-dd');
  return out;
}

/** 시트의 머리글 순서대로 rows(머리글 이름 → 값)를 씁니다. 선생님이 열 순서를 바꿔도 괜찮습니다. */
function writeRows_(sh, rows) {
  const want = SHEETS[sh.getName()];
  let headers = sh.getLastColumn() ? sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(h => String(h).trim()) : [];
  want.forEach(h => { if (headers.indexOf(h) < 0) { headers.push(h); sh.getRange(1, headers.length).setValue(h); } });
  const last = sh.getLastRow();
  if (last > 1) sh.getRange(2, 1, last - 1, headers.length).clearContent();
  if (!rows.length) return;
  const matrix = rows.map(r => headers.map(h => {
    let v = r[h];
    if (v === undefined || v === null) return '';
    if (NUMERIC.indexOf(h) >= 0) { const n = Number(v); return (v === '' || isNaN(n)) ? '' : n; }
    v = String(v);
    return v.charAt(0) === '=' ? "'" + v : v;          // 수식으로 해석되지 않게
  }));
  headers.forEach((h, i) => { if (NUMERIC.indexOf(h) < 0) sh.getRange(2, i + 1, matrix.length, 1).setNumberFormat('@'); });
  sh.getRange(2, 1, matrix.length, headers.length).setValues(matrix);
}

function touch_() {
  PropertiesService.getScriptProperties().setProperty('UPDATED', Utilities.formatDate(new Date(), TZ, 'yyyy-MM-dd'));
}

